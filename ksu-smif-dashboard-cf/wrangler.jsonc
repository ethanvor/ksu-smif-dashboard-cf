// Cloudflare settings for the SMIF dashboard (Workers + static assets).
{
  // must match the project name shown in the Cloudflare dashboard
  "name": "smif",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // storage for the master copy + trade history (your "smif-data" KV namespace)
  "kv_namespaces": [
    { "binding": "SMIF_KV", "id": "28159bcb14dc4e5d9cb1c9805231f154" }
  ],
  "observability": { "enabled": true }
}
